// TempNewsletterRegister.gs
// =====================================================
// 臨時お知らせ号の登録用ワンショット関数
// GASエディタから tmpRegisterOshirase20260724 を1回実行すると
// ニュースレターシートに配信行を追加し、翌朝9時台のcronで配信される。
// ※ 実行・配信確認後はこのファイルごと削除する
// =====================================================

function tmpRegisterOshirase20260724() {
  var title = '1点からご注文いただけるようになりました';
  var body = 'いつもデタウリ.Detauri をご利用いただきありがとうございます。\n'
    + 'システム改善のお知らせです。\n\n'
    + '■ すべての商品が1点からご注文可能に\n'
    + 'これまで一定数以上でお願いしていた最低注文数を見直し、\n'
    + 'すべての商品を1点からご注文いただけるようになりました。\n'
    + '「まず品質を確かめたい」「少量だけ仕入れたい」という場合も、\n'
    + 'どうぞお気軽にお試しください。\n\n'
    + '■ お知らせメールの品質改善\n'
    + 'ご案内メールが重複して届く場合があった問題や、\n'
    + '一部のご案内が届かない場合があった不具合を修正しました。\n'
    + '今後も快適にご利用いただけるよう改善を続けてまいります。\n\n'
    + '今後ともデタウリ.Detauri をよろしくお願いいたします。';

  var sheet = getNewsletterSheet_();
  var data = sheet.getDataRange().getValues();
  for (var i = 1; i < data.length; i++) {
    if (String(data[i][0] || '').trim() === title) {
      console.log('tmpRegisterOshirase20260724: 同タイトルの行が既に存在するためスキップ（行' + (i + 1) + '）');
      return;
    }
  }

  // 列構成: タイトル / 本文 / 配信日時 / ステータス / 頻度 / 最終配信日 / 対象 / 送信済み(分割)
  sheet.appendRow([title, body, new Date(2026, 6, 24, 9, 0, 0), '配信待ち', '一度', '', '全員', '']);
  console.log('tmpRegisterOshirase20260724: 登録完了。明朝9時台のcronで全員に配信されます');
}
